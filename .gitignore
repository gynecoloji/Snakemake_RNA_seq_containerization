# ── Reference genomes, indexes, large annotations (provide/build locally) ──
*.fa
*.fa.gz
*.fai
*.2bit
*.gtf
*.bed
*.jar
*.ht2
ref/ENSEMBL/
ref/Salmon_index_Grch38/
ref/Salmon_index_decoy_Grch38/

# ── Raw data & pipeline outputs ──
data/*
!data/.gitkeep
results/
logs/
temp/
*.bam
*.bai
*.sam

# ── Internal design docs & workflow scratch ──
docs/
.superpowers/
.snakemake/

# ── Container images ──
*.sif

# ── Python / pytest ──
__pycache__/
*.py[cod]
.pytest_cache/
env/
venv/
ENV/

# ── OS & editor ──
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ── Keep the .test/ placeholder inputs tracked despite the patterns above ──
!.test/
!.test/**
# ...but never track Snakemake's runtime cache/logs written under it.
.test/.snakemake/
