# RNA-seq analysis — Snakemake Workflow Catalog entry point. A single
# `snakemake --use-conda` builds the core stage, advanced QC, and Salmon
# quantification in dependency order (unified DAG). Run a subset with the
# rna_all / qc_all / salmon_all targets:
#
#   snakemake --use-conda --cores 20                 # everything
#   snakemake --use-conda --cores 20 rna_all         # core RNA-seq only
#   snakemake --use-conda --cores 20 qc_all          # advanced QC only
#   snakemake --use-conda --cores 20 salmon_all      # Salmon only
#
# Differential expression is an OPT-IN stage (needs >=2 conditions in samples.csv);
# it is not part of the default target:
#   snakemake --use-conda --cores 8 deg_all          # gene-level DESeq2 DEG + GO/KEGG enrichment
#   snakemake --use-conda --cores 20 txq_all         # bootstrap+bias Salmon quant (prereq for DTE)
#   snakemake --use-conda --cores 8 dte_all          # ★ transcript DE — edgeR catchSalmon (needs r-transcript env)
#   snakemake --use-conda --cores 8 dtu_dexseq_all   # DTU interpretation layer (DRIMSeq -> DEXSeq)
#   snakemake --use-conda --cores 4 tx_report_all    # ★ annotated DTE report (DTE x gene-DGE x DTU)
#   snakemake --use-conda --cores 8 det_all          # legacy naive transcript DE (NumReads->DESeq2)
#
# Reference genomes/annotation are provided by the user under ref/ (see README).

from snakemake.utils import min_version

min_version("8.0")


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/rnaseq.smk"
include: "rules/qc.smk"
include: "rules/salmon.smk"
include: "rules/deg.smk"
include: "rules/det.smk"
include: "rules/transcript_de.smk"


rule all:
    input:
        rules.rna_all.input,
        rules.qc_all.input,
        rules.salmon_all.input,
    default_target: True
