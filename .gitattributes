# Keep generated artifacts out of GitHub's language bar.
.test/**                linguist-generated

# Normalize text to LF; scripts/Snakemake files MUST stay LF for Linux containers.
* text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.smk       text eol=lf
Snakefile   text eol=lf
Dockerfile  text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
